# Copy to .env.local. Everything is optional for local development.

# Public base URL, used in SMS links and the embed snippet.
APP_URL=http://localhost:3000

# Postgres (Supabase) connection string. When unset, an embedded Postgres
# (PGlite) stores data in ./.data/pglite.
# DATABASE_URL=postgres://user:pass@host:5432/db

# Protects /api/cron/tick (call it every minute from a scheduler in production).
CRON_SECRET=change-me

# In-process job ticker (runs reminders every 30s). Set to "off" when an external cron calls /api/cron/tick.
# JOB_TICKER=off

# Twilio (master account; each owner's subaccount SID + number is set in Settings).
# When unset, texts are simulated and written to the Messages log only.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=

# Google Calendar OAuth (full read/write). Redirect URI: ${APP_URL}/api/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
